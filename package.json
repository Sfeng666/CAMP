{
  "name": "@camp-memory/cli",
  "version": "0.1.2",
  "description": "Cross-Agent Memory for Projects — local-first project context for coding agents.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sfeng666/CAMP.git"
  },
  "homepage": "https://github.com/Sfeng666/CAMP#readme",
  "bugs": {
    "url": "https://github.com/Sfeng666/CAMP/issues"
  },
  "bin": {
    "camp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "IMPLEMENTATION_PLAN.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "assets/camp-logo.png"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "agent-memory",
    "mcp",
    "codex",
    "claude-code",
    "cursor",
    "antigravity",
    "project-memory"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.11.1",
    "chatcrystal": "0.5.8",
    "commander": "14.0.3",
    "memorix": "1.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.17",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
